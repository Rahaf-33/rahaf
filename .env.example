# ─────────────────────────────────────────────────────────────
# بصمة رقمية — متغيرات البيئة
# انسخي هذا الملف إلى ‎.env.local‎ للتشغيل المحلي، وأضيفي القيم نفسها
# في Vercel › Project › Settings › Environment Variables عند النشر.
# ─────────────────────────────────────────────────────────────

# رابط مشروع Supabase (Project Settings › API › Project URL) — عام وآمن في المتصفح
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# المفتاح العام anon / publishable (Project Settings › API) — عام وآمن في المتصفح؛
# صلاحياته مقيدة بسياسات RLS: قراءة المشاركات الظاهرة فقط.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# مفتاح service_role / secret — سري جدًا، يُستخدم في الخادم فقط (بدون NEXT_PUBLIC)
# لحفظ المشاركات وإصدار روابط الرفع وإخفاء/حذف المشاركات.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# كلمة مرور لوحة الإدارة (/admin) لإخفاء أو حذف المشاركات — اختاري كلمة قوية
ADMIN_PASSWORD=change-me-to-a-strong-password

# الرابط العام للمنصة بعد النشر (يُستخدم لرمز QR). مثال: https://basmah.vercel.app
# إن تُرك فارغًا تستخدم صفحة QR رابط الصفحة الحالي تلقائيًا.
NEXT_PUBLIC_SITE_URL=
